@model IEnumerable<StudentCourseRegistration.Models.Student>

<h2>Student List</h2>

<a asp-action="Create">Register New Student</a>

<br />
<br />

<table border="1" cellpadding="10">

    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Course</th>
        <th>Semester</th>
        <th>Action</th>
    </tr>

    @foreach (var student in Model)
    {
        <tr>
            <td>@student.Id</td>
            <td>@student.Name</td>
            <td>@student.Email</td>
            <td>@student.Course</td>
            <td>@student.Semester</td>

            <td>
                <a asp-action="Details"
                   asp-route-id="@student.Id">
                    View Details
                </a>
            </td>
        </tr>
    }

</table>